<Window x:Class="VPNTray.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNTray Setup" Width="420" Height="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="8" Background="{StaticResource WindowBgGlass}">
        <DockPanel>
            <!-- Custom title bar (draggable) with step dots -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBgGlass}" CornerRadius="8,8,0,0"
                    Padding="16,11,8,11" MouseLeftButtonDown="OnHeaderDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                            Click="OnTitleClose" VerticalAlignment="Top" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Viewbox Width="19" Height="19" VerticalAlignment="Center">
                            <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource Accent}"/>
                        </Viewbox>
                        <TextBlock Text="Set up VPNTray" Style="{StaticResource H1}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="Dot0" Width="7" Height="7" CornerRadius="3.5" Margin="3,0" Background="{StaticResource Accent}"/>
                        <Border x:Name="Dot1" Width="7" Height="7" CornerRadius="3.5" Margin="3,0" Background="{StaticResource InputBorder}"/>
                        <Border x:Name="Dot2" Width="7" Height="7" CornerRadius="3.5" Margin="3,0" Background="{StaticResource InputBorder}"/>
                        <Border x:Name="Dot3" Width="7" Height="7" CornerRadius="3.5" Margin="3,0" Background="{StaticResource InputBorder}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}"/>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgGlass}" CornerRadius="0,0,8,8" Padding="18,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Click="OnBack" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource PrimaryButton}" Click="OnNext"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="18,13">
                    <!-- Step 1: Welcome -->
                    <StackPanel x:Name="WelcomePane">
                        <TextBlock Text="Welcome" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                            Text="This wizard checks the bundled VPN tools (openconnect, Wintun, scripts) and collects your VPN credentials. Click Next to begin."/>
                    </StackPanel>

                    <!-- Step 2: Dependency check -->
                    <StackPanel x:Name="DepsPane" Visibility="Collapsed">
                        <TextBlock Text="Dependency check" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,2"
                            Text="The native tools are bundled — these should all be green."/>
                        <ItemsControl x:Name="DepsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="badge" Width="16" Height="16" CornerRadius="8"
                                                Margin="0,1,9,0" VerticalAlignment="Top"
                                                Background="{StaticResource ErrRed}">
                                            <TextBlock x:Name="glyph" Text="!" Foreground="White" FontSize="10"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
                                            <TextBlock x:Name="hint" Text="{Binding Hint}" Style="{StaticResource Body}"
                                                       FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                            <Setter TargetName="badge" Property="Background" Value="{StaticResource OkGreen}"/>
                                            <Setter TargetName="glyph" Property="Text" Value="&#x2713;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Hint}" Value="">
                                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="RecheckButton" Content="Recheck" Click="OnRecheck"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Step 3: Credentials -->
                    <StackPanel x:Name="CredsPane" Visibility="Collapsed">
                        <TextBlock Text="Credentials" Style="{StaticResource H1}"/>
                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="0,7,0,3"/>
                        <TextBox x:Name="OnbUsername"/>
                        <TextBlock Text="Password prefix" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="OnbPrefix"/>
                        <TextBlock Text="TOTP secret (Base32)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="OnbTotp"/>
                        <TextBlock Text="Gateway" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OnbGateway"/>
                        <TextBlock Text="Server cert pin" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OnbPin"/>
                    </StackPanel>

                    <!-- Step 4: Done -->
                    <StackPanel x:Name="DonePane" Visibility="Collapsed">
                        <TextBlock Text="All set" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                            Text="Setup complete. Click Done to return to the tray, then click the tray icon and choose Connect."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
