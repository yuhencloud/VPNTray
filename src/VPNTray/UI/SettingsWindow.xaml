<Window x:Class="VPNTray.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNTray" Width="380" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="8" Background="{StaticResource WindowBgGlass}">
        <DockPanel>
            <!-- Custom title bar (draggable) -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBgGlass}" CornerRadius="8,8,0,0"
                    Padding="14,9,8,9" MouseLeftButtonDown="OnHeaderDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                            Click="OnTitleClose" VerticalAlignment="Top" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource Accent}"/>
                        </Viewbox>
                        <TextBlock Text="VPNTray" Style="{StaticResource H1}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}"/>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgGlass}" CornerRadius="0,0,8,8" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnSave"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <!-- Connection status + Connect/Disconnect -->
                    <Border Background="{StaticResource CardBgGlass}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect"
                                    Style="{StaticResource PrimaryButton}" MinWidth="104" Padding="16,6"
                                    Click="OnConnectToggle" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="11" Height="11" VerticalAlignment="Center" Fill="#9CA3AF"/>
                                <TextBlock x:Name="StatusText" Text="Disconnected" Margin="9,0,0,0"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Credentials" Style="{StaticResource H1}" Margin="0,0,0,2"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PwdBox"/>

                    <TextBlock Text="TOTP secret (Base32)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="TotpBox"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Import QR image…" Click="OnImportQrFile" FontSize="11" Padding="16,5" MinWidth="130"/>
                        <Button Content="Scan screen for QR" Click="OnScanQrScreen" FontSize="11" Padding="16,5" MinWidth="130" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Gateway" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="GatewayBox"/>

                    <TextBlock Text="Server cert pin" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PinBox"/>

                    <!-- Bundled-tools check (openconnect / wintun / vpnc script) -->
                    <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>
                    <Button x:Name="CheckButton" Content="Check tools" Click="OnCheckTools"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <ItemsControl x:Name="DepsList" Margin="0,8,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="badge" Width="16" Height="16" CornerRadius="8"
                                            Margin="0,1,9,0" VerticalAlignment="Top"
                                            Background="{StaticResource ErrRed}">
                                        <TextBlock x:Name="glyph" Text="!" Foreground="White" FontSize="10"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
                                        <TextBlock x:Name="hint" Text="{Binding Hint}" Style="{StaticResource Body}"
                                                   FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                        <Setter TargetName="badge" Property="Background" Value="{StaticResource OkGreen}"/>
                                        <Setter TargetName="glyph" Property="Text" Value="&#x2713;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                        <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hint}" Value="">
                                        <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
