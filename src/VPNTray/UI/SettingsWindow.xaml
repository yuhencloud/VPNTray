<Window x:Class="VPNTray.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNTray" Width="380" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="8" Background="{StaticResource WindowBg}">
        <DockPanel>
            <!-- Custom title bar (draggable) -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" CornerRadius="8,8,0,0"
                    Padding="14,9,8,9" MouseLeftButtonDown="OnHeaderDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                            Click="OnTitleClose" VerticalAlignment="Top" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource Accent}"/>
                        </Viewbox>
                        <TextBlock Text="VPNTray" Style="{StaticResource H1}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <!-- Baseline-aligned rather than centred, so it reads as a suffix to
                             the name instead of a second heading. Text set in code-behind. -->
                        <TextBlock x:Name="VersionText" Style="{StaticResource Body}"
                                   FontSize="10.5" Margin="7,0,0,2" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Divider}"/>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBg}" CornerRadius="0,0,8,8" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnSave"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <!-- Connection status + Connect/Disconnect -->
                    <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect"
                                    Style="{StaticResource PrimaryButton}" MinWidth="104" Padding="16,6"
                                    Click="OnConnectToggle" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="11" Height="11" VerticalAlignment="Center" Fill="#9CA3AF"/>
                                <TextBlock x:Name="StatusText" Text="Disconnected" Margin="9,0,0,0"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Credentials" Style="{StaticResource H1}" Margin="0,0,0,2"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PwdBox"/>

                    <TextBlock Text="TOTP secret (Base32)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="TotpBox"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Import QR image…" Click="OnImportQrFile" FontSize="11" Padding="16,5" MinWidth="130"/>
                        <Button Content="Scan screen for QR" Click="OnScanQrScreen" FontSize="11" Padding="16,5" MinWidth="130" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Gateway" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="GatewayBox"/>

                    <TextBlock Text="Server cert pin" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PinBox"/>

                    <!-- DNS — collapsed by default: the shipped defaults suit most people,
                         so the header carries a summary and only the curious need to open it. -->
                    <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>
                    <Border Background="Transparent" Cursor="Hand" Padding="0,12,0,2"
                            MouseLeftButtonUp="OnToggleDnsSection">
                        <DockPanel>
                            <TextBlock x:Name="DnsChevron" DockPanel.Dock="Left" Text="&#x25B8;"
                                       FontSize="10" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="DNS" Style="{StaticResource H1}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="DnsSummary" Style="{StaticResource Body}" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <!-- Two named modes rather than one checkbox: the off state of "use the
                         VPN's DNS" reads as "leave DNS alone", which is not what it does. -->
                    <StackPanel x:Name="DnsPanel" Visibility="Collapsed">
                        <RadioButton x:Name="InternalDnsRadio" GroupName="DnsMode" Margin="0,10,0,0"
                                     Content="Send every name to the VPN's internal DNS"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="24,3,0,0"
                                   Text="Internal names such as *.corp resolve. Recommended — this is what the gateway expects."/>

                        <!-- Exceptions to mode 1, so they live under it and grey out with it. -->
                        <StackPanel Margin="24,0,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=InternalDnsRadio}">
                            <TextBlock Text="Advanced — public-DNS exceptions" Style="{StaticResource FieldLabel}"
                                       Margin="0,10,0,3"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                       Text="Empty unless you need it. Add a name here only after confirming the internal resolver answers it with an address that does not route — compare the two answers with Resolve-DnsName."/>

                            <TextBlock Text="Domains" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BypassDomainsBox"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Comma separated, e.g. .example.com, api.example.net — a leading dot also covers every subdomain."/>

                            <TextBlock Text="Resolved through" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BypassServersBox"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Comma separated IP addresses of a public resolver, tried in order."/>
                        </StackPanel>

                        <RadioButton x:Name="PublicDnsRadio" GroupName="DnsMode" Margin="0,14,0,0"
                                     Content="Send every name to public DNS"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="24,3,0,0"
                                   Text="The VPN does not touch DNS at all; your normal resolver keeps answering everything. Internal names such as *.corp return NXDOMAIN."/>
                    </StackPanel>

                    <!-- Startup -->
                    <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>
                    <Border Background="Transparent" Cursor="Hand" Padding="0,12,0,2"
                            MouseLeftButtonUp="OnToggleStartupSection">
                        <DockPanel>
                            <TextBlock x:Name="StartupChevron" DockPanel.Dock="Left" Text="&#x25B8;"
                                       FontSize="10" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="Startup" Style="{StaticResource H1}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="StartupSummary" Style="{StaticResource Body}" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                        <CheckBox x:Name="LaunchAtLoginBox" Content="Launch at login" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="24,4,0,0"
                                   Text="Registers a scheduled task that starts VPNTray elevated at sign-in, so it comes up without a UAC prompt. Turning this off deletes the task."/>

                        <!-- Nested and greyed with its parent: without the logon start there is
                             no launch this could apply to. -->
                        <CheckBox x:Name="ConnectAtLoginBox" Content="Connect automatically" Margin="24,10,0,0"
                                  IsEnabled="{Binding IsChecked, ElementName=LaunchAtLoginBox}"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="48,4,0,0"
                                   Text="Dial the VPN as soon as the logon start comes up. Only that start — opening the app yourself never auto-connects."/>

                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="Wrap" Margin="24,10,0,0"
                                   Text="Applied immediately — these are not part of Save."/>
                    </StackPanel>

                    <!-- Bundled-tools check (openconnect / wintun / vpnc script). Same
                         collapsible shape as DNS above; the header carries the verdict, so the
                         section only has to be opened to find out which check failed. -->
                    <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>
                    <Border Background="Transparent" Cursor="Hand" Padding="0,12,0,2"
                            MouseLeftButtonUp="OnToggleToolsSection">
                        <DockPanel>
                            <TextBlock x:Name="ToolsChevron" DockPanel.Dock="Left" Text="&#x25B8;"
                                       FontSize="10" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Text="Tools" Style="{StaticResource H1}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ToolsSummary" Style="{StaticResource Body}" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <StackPanel x:Name="ToolsPanel" Visibility="Collapsed">
                        <ItemsControl x:Name="DepsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="badge" Width="16" Height="16" CornerRadius="8"
                                                Margin="0,1,9,0" VerticalAlignment="Top"
                                                Background="{StaticResource ErrRed}">
                                            <TextBlock x:Name="glyph" Text="!" Foreground="White" FontSize="10"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
                                            <TextBlock x:Name="hint" Text="{Binding Hint}" Style="{StaticResource Body}"
                                                       FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                            <Setter TargetName="badge" Property="Background" Value="{StaticResource OkGreen}"/>
                                            <Setter TargetName="glyph" Property="Text" Value="&#x2713;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Hint}" Value="">
                                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="RecheckButton" Content="Re-check" Click="OnRecheckTools"
                                HorizontalAlignment="Left" FontSize="11" Padding="16,5"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
