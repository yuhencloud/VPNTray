<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VPNTray</RootNamespace>
    <AssemblyName>VPNTray</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>App/app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/icons/app.ico</ApplicationIcon>
    <!-- Single source of truth for the release number. Shown in the title bar via
         Util/AppVersion, and scripts/build-installer.ps1 reads it from here to set the MSI's
         ProductVersion and the .msi file name. Bump it here only. -->
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources/icons/*.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\*.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\*.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
